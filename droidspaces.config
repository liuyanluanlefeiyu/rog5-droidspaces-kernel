# ==============================================================
# ROG Phone 5 (ZS673KS / I005D / anakin) DroidSpaces 内核配置片段
# 适用源码树: msm-5.4 (LA.UM.9.14.r1-20800-LAHAINA.QSSI13.0, 5.4.210-qgki-perf)
# 基础配置: vendor/anakin_defconfig
# 说明: 此文件为参考清单;构建脚本里已用 scripts/config 等效写入,
#       也可用 merge_config.sh 手动合并。
# ==============================================================

# ---- DroidSpaces 核心能力(缺一不可) ----
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- cgroup 资源限制 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y

# ---- tmpfs 扩展属性 (NixOS 等发行版需要) ----
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# ---- 容器网络 / Docker / NAT / 防火墙 (可选但推荐) ----
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# ==============================================================
# 注意事项:
# 1. CONFIG_USER_NS 开启后建议同步应用 Droidspaces 补丁仓库
#    (Goldzxcbug/Droidspaces_Kernel_patch) CVE-UserNS 目录下的
#    修复补丁, 降低提权漏洞风险。
# 2. 5.4 内核无法支持 CONFIG_NTSYNC(Wine/Proton 场景会退化),
#    该特性无可用 backport, 请勿尝试自行开启。
# 3. 构建兼容性: 关闭 CONFIG_UAPI_HEADER_TEST 与 CONFIG_IKHEADERS
#    (前者是编译期头文件自检, clang-14 会因 bcache.h 的 GNU 扩展告警
#    直接报错; 后者是头文件导出调试模块。两者都不影响运行时行为、
#    不影响模块 ABI 兼容性。)
# 4. SYSVIPC 与 POSIX_MQUEUE 两个字段已通过 0001/0002 补丁改为
#    KABI 预留槽实现, 因此不会改变 task_struct / user_struct 的
#    符号 CRC, 原厂 vendor 模块可原样继续加载。
# ==============================================================
